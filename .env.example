# Copy this file to .env and fill in your own values. .env is git-ignored.

# IBM watsonx.ai (used in several IBM labs)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# OpenAI-compatible providers (optional, depending on the lab)
OPENAI_API_KEY=

# Hugging Face (optional, for hosted inference / gated models)
HUGGINGFACEHUB_API_TOKEN=

# Tavily / SerpAPI etc. for agent web-search tools (optional)
TAVILY_API_KEY=
